{
  "appId": "br.com.escolatorredemarfim.torre360",
  "appName": "Torre 360",
  "webDir": "public",
  "server": {
    "url": "https://torre360.escolatorredemarfim.com.br",
    "hostname": "torre360.escolatorredemarfim.com.br",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "torre360.escolatorredemarfim.com.br",
      "*.escolatorredemarfim.com.br",
      "*.google.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#1e1e2e",
    "appendUserAgent": "Torre360App"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#1e1e2e"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "large",
      "spinnerColor": "#5594ad",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}