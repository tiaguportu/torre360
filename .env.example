APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Lança exceção ao carregar relações sob demanda (N+1). Sempre ligado nos testes; use true só em desenvolvimento.
DB_PREVENT_LAZY_LOADING=false
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GEMINI_API_KEY=
# Tempo maximo (segundos) de uma consulta ao Gemini, somando tentativas e modelos de contingencia:
# telas do painel / analise de documentos (roda em fila). O timeout do job (85 s) deve ficar abaixo do retry_after da fila (90 s).
GEMINI_ORCAMENTO_SEGUNDOS=60
GEMINI_ORCAMENTO_DOCUMENTO_SEGUNDOS=70
# Fila dedicada a analise de documentos por IA (o agendador mantem um worker para ela).
CRM_FILA_IA=ia

# CRM: regua de follow-up (roda de hora em hora), LGPD e retencao.
# Eventos de ate N dias atras que ainda nao receberam a mensagem tambem entram (agendador parado).
CRM_REGUA_JANELA_RECUPERACAO_DIAS=2
# Maximo de e-mails da regua por lead por dia (0 = sem limite).
CRM_REGUA_MAX_EMAILS_POR_LEAD_DIA=2
# Rascunho de pre-matricula (CPF, endereco) parado e sem interacao ha mais de N dias e apagado.
CRM_RETENCAO_RASCUNHO_DIAS=90
# Mostrados no aviso de consentimento do formulario publico (a escola define o texto e o canal do titular).
CRM_URL_POLITICA_PRIVACIDADE=
CRM_CONTATO_PRIVACIDADE=

# Busca de livros por ISBN (Biblioteca).
# Chave da API do Google Books (opcional; sem ela a cota anonima e bem menor).
GOOGLE_BOOKS_API_KEY=
# Raspagem da Amazon (autores/capas): nao oficial e contraria aos termos de uso do site. Desligada por padrao.
LIVROS_AMAZON_HABILITADO=false

# Caminho do binario PHP usado pelo botao manual "Processar Fila Agora" (QueueSupervisorWidget).
# Em hospedagem compartilhada (cPanel) o "php" generico pode nao estar no PATH do processo web;
# use o mesmo binario configurado no cron job (ex.: /usr/local/bin/ea-php82).
QUEUE_PHP_BINARY=php

# Content-Security-Policy: report-only (padrao, so relata violacoes em /api/csp-report), enforce (bloqueia) ou off.
# Passe para enforce depois de uma semana sem violacoes legitimas no log. Ver docs/seguranca_hardening.md.
CSP_MODO=report-only
# Origens extras aceitas pela politica estrita, separadas por virgula (ex.: CSP_EXTRA_SCRIPT_SRC=https://exemplo.com).
# CSP_EXTRA_SCRIPT_SRC=
# CSP_EXTRA_STYLE_SRC=
# CSP_EXTRA_IMG_SRC=
# CSP_EXTRA_FONT_SRC=
# CSP_EXTRA_CONNECT_SRC=
# CSP_EXTRA_FRAME_SRC=

# Matricula online publica (/matricular-online): tentativas por IP e validade do link da tela de confirmacao.
# MATRICULA_ONLINE_MAX_TENTATIVAS=6
# MATRICULA_ONLINE_JANELA_MINUTOS=60
# MATRICULA_ONLINE_LINK_SUCESSO_HORAS=2

# Webhook de pagamento (/api/webhooks/pagamento): segredo HMAC-SHA256 compartilhado com o gateway (header
# X-Pagamento-Signature). Vazio, o endpoint recusa tudo com 503. Defina antes de ligar um gateway real.
# PAGAMENTOS_WEBHOOK_SECRET=

# Assinatura digital de contratos (Assinafy). Credenciais REAIS do ambiente em que o sistema roda.
# ATENCAO: o phpunit.xml zera ASSINAFY_API_KEY e ASSINAFY_ACCOUNT_ID, entao a suite de testes nunca as usa.
ASSINAFY_API_URL=https://api.assinafy.com.br/v1
ASSINAFY_API_KEY=
ASSINAFY_ACCOUNT_ID=
# ASSINAFY_WEBHOOK_SECRET=

# Teste de integracao REAL contra o SANDBOX do Assinafy (tests/Feature/Integracao/AssinafySandboxTest.php).
# Nomes proprios, para nunca se misturar com as credenciais acima. Nunca coloque credenciais de producao aqui:
# o teste recusa qualquer URL que nao seja do host sandbox.assinafy.com.br. Fica desligado; para rodar:
#   RODAR_SANDBOX_ASSINAFY=1 php artisan test --filter=AssinafySandboxTest
ASSINAFY_SANDBOX_API_URL=https://sandbox.assinafy.com.br/v1
ASSINAFY_SANDBOX_API_KEY=
ASSINAFY_SANDBOX_ACCOUNT_ID=

# CRM - Previsão de receita (Lote D2)
CRM_TICKET_MEDIO_PADRAO=1500.00
CRM_PROBABILIDADE_PADRAO=20.0
